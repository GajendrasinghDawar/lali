{
  "name": "lali",
  "version": "1.0.0",
  "description": "A personal AI assistant agent you talk to over Telegram. Runs on a server, accepts commands, reads and writes files, remembers things across\r sessions, and checks in on you with scheduled briefings.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start:agent": "node --permission --allow-fs-read=* --allow-fs-write=* --experimental-strip-types src/agent/server.ts",
    "start:gateway": "node --permission --allow-fs-read=* --allow-fs-write=* --experimental-strip-types src/gateway/server.ts",
    "dev:agent": "node --watch --experimental-strip-types src/agent/server.ts",
    "dev:gateway": "node --watch --experimental-strip-types src/gateway/server.ts",
    "dev:web": "vite dev src/web --config src/web/vite.config.ts",
    "dev": "concurrently \"npm run dev:agent\" \"npm run dev:gateway\" \"npm run dev:web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GajendrasinghDawar/lali.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GajendrasinghDawar/lali/issues"
  },
  "homepage": "https://github.com/GajendrasinghDawar/lali#readme",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@tanstack/react-router": "^1.170.36",
    "@types/node": "^26.4.0",
    "better-auth": "^1.7.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
