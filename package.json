{
  "name": "lali",
  "version": "1.0.0",
  "description": "A personal AI assistant agent you talk to over Telegram. Runs on a server, accepts commands, reads and writes files, remembers things across\r sessions, and checks in on you with scheduled briefings.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:agent": "tsx src/agent/server.ts",
    "dev:gateway": "tsx src/gateway/server.ts",
    "dev": "concurrently \"npm run dev:agent\" \"npm run dev:gateway\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GajendrasinghDawar/lali.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GajendrasinghDawar/lali/issues"
  },
  "homepage": "https://github.com/GajendrasinghDawar/lali#readme",
  "dependencies": {
    "@types/node": "^26.4.0",
    "better-auth": "^1.7.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
